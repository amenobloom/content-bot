# Шаблон настроек. Скопируйте в .env и заполните:
#   cp .env.example .env

# Токен бота от @BotFather (формат: 123456:ABC-DEF...)
BOT_TOKEN=your_token_here

# Telegram ID администратора (узнать: @userinfobot) —
# сюда приходят отчёты об оплатах
ADMIN_ID=123456789

# Прокси Telegram API (Cloudflare Worker) — НЕобязательно.
# Пусто = прямое подключение к api.telegram.org.
PROXY_URL=https://your-worker.workers.dev

# --- Постоянное хранилище ---
# Локально: data/. На Amvera: /data (монтируется по amvera.yml).
PERSISTENCE_DIR=data
